# Backend REST API Base URL (Live Render or Local)
# For Live Render: https://<your-render-service-name>.onrender.com
# For Local Dev: http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Mock layer toggle (set to 'false' to communicate with the real live backend)
NEXT_PUBLIC_USE_MOCKS=false
